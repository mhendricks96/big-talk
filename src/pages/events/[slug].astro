---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const isStripe = data.registrationType === 'stripe';
---

<BaseLayout title={`${data.title} - Big Talk Counseling`}>
  <Header slot="header" />

  <section id="events-hero" class="about-hero"></section>

  <section class="events-section">
    <h1 class="events-title">{data.title}</h1>
    <div class="events-content">
      <div class="event-card event-card-extended">

        {data.image && (
          <div class="event-image-section">
            <img
              src={data.image}
              alt={data.imageAlt || data.title}
              style={data.slug === 'journaling-disabled-joy' ? 'object-position: center 20%;' : ''}
            />
          </div>
        )}

        <div class="event-details">
          <h2>Event Description</h2>
          {data.title && <p><strong>Name:</strong> {data.title}{data.subtitle ? `: ${data.subtitle}` : ''}</p>}
          {data.eventType && (
            <p><strong>Details:</strong> {
              data.eventType === 'webinar' ? 'Webinar' :
              data.eventType === 'in-person' ? 'In-Person' :
              'Recurring Group'
            }{data.location ? ` · ${data.location}` : ''}</p>
          )}
          {data.schedule && <p><strong>Schedule:</strong> {data.schedule}</p>}
          {data.date && <p><strong>Date:</strong> {data.date}</p>}
          {data.time && <p><strong>Time:</strong> {data.time}</p>}
          {!data.schedule && data.location && <p><strong>Location:</strong> {data.location}</p>}
          {data.cost && <p><strong>Cost:</strong> {data.cost}</p>}
          {data.facilitator && <p><strong>Facilitated by:</strong> {data.facilitator}</p>}

          <div class="event-description">
            <Content />
          </div>

          {isStripe && data.stripeOptions && data.stripeOptions.length > 0 ? (
            <div class="event-register">
              <label for={`register-${event.slug}`}>Register for your household:</label>
              <div class="register-form-fields">
                <input type="text" id="register-name" class="register-input" placeholder="Full Name" required />
                <input type="email" id="register-email" class="register-input" placeholder="Email Address" required />
              </div>
              <select id={`register-${event.slug}`} class="register-dropdown" data-event-name={data.title}>
                <option value="">Select pricing option</option>
                {data.stripeOptions.map((opt) => (
                  <option value={opt.value} data-stripe-url={opt.stripeUrl || ''}>{opt.label}</option>
                ))}
              </select>
              <span class="register-btn-wrapper" data-tooltip="Please fill in your name, email, and select a pricing option">
                <button class="register-btn" disabled>Register</button>
              </span>
            </div>
          ) : (
            <>
              {data.contactNote && <p><strong>{data.contactNote}</strong></p>}
              <a href="/contact" class="flyer-btn">Contact</a>
            </>
          )}
        </div>

        {data.showSlidingScale && (
          <div class="sliding-scale">
            <h3>Sliding Scale Guidelines</h3>
            <p>
              This event is offered on a sliding scale basis to make it accessible to everyone,
              while also valuing the time, labor, and resources that go into creating and delivering it.
            </p>
            <p>Please choose the fee that best reflects your financial situation and what feels right for you.</p>
            <ul class="scale-options">
              <li><strong>$0 - Small Talk</strong><br />Choose this if paying would cause financial hardship or prevent you from meeting your basic needs.</li>
              <li><strong>$5 — Mid Talk</strong><br />Choose this if you have limited income or are balancing expenses carefully, but still want to contribute something toward the event.</li>
              <li><strong>$10 — Big Talk</strong><br />Choose this if you have stable income and can comfortably meet your basic needs of your home (like rent, food, transportation, etc.).</li>
              <li><strong>$20 — Bigger Talk</strong><br />Choose this if your home has more than one consistent income, comfortable savings, or discretionary income and/or you would like to pay it forward for another participant's fee.</li>
              <li><strong>$50 — Biggest Talk</strong><br />Choose this if you have discretionary income and would like to ensure Big Talk is able to continue parent and adolescent workshops.<br /><em>THANK YOU</em></li>
            </ul>
            <div class="scale-footer">
              <h4>How It Works</h4>
              <p>Pay what feels doable for you — no questions asked. Everyone receives the same content and experience, regardless of ability to pay.</p>
            </div>
          </div>
        )}

      </div>
    </div>
  </section>

  <Footer slot="footer" />

  {isStripe && <script slot="scripts" src="/javascript/events.js"></script>}
</BaseLayout>
