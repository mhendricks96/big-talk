---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Registration Confirmed - Big Talk Counseling">
  <Header slot="header" />

  <section class="confirmation-section">
    <div class="confirmation-content">
      <svg
        class="confirmation-checkmark"
        viewBox="0 0 52 52"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="26" cy="26" r="25" fill="none" stroke="#235C33" stroke-width="2"></circle>
        <path
          fill="none"
          stroke="#235C33"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M14 27l7 7 16-16"></path>
      </svg>
      <h1>Thank You for Registering!</h1>
      <p>Check your email for a receipt and keep an eye out for further event details.</p>
      <a href="/events" class="confirmation-btn">Back to Events</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
