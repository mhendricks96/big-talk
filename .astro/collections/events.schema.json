{
  "$ref": "#/definitions/events",
  "definitions": {
    "events": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "webinar",
            "in-person",
            "recurring-group"
          ],
          "default": "webinar"
        },
        "cost": {
          "type": "string"
        },
        "facilitator": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "ctaLabel": {
          "type": "string",
          "enum": [
            "Register Now",
            "Learn More",
            "Sign Up",
            "Contact"
          ],
          "default": "Learn More"
        },
        "showInNav": {
          "type": "boolean",
          "default": true
        },
        "registrationType": {
          "type": "string",
          "enum": [
            "contact",
            "stripe"
          ],
          "default": "contact"
        },
        "contactNote": {
          "type": "string"
        },
        "stripeOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "stripeUrl": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "showSlidingScale": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}